# Copy to .env and fill in. Never commit the filled-in copy.

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Supabase (PostgreSQL) ------------------------------------------------
# Two connection strings, and the difference matters.
#
#   DIRECT (5432)  migrations and the data loader. The loader needs
#                  BYPASSRLS: 003 FORCEs row-level security and the only
#                  policies are SELECT, so without it writes fail outright.
#                  Check first:
#                    SELECT rolbypassrls FROM pg_roles WHERE rolname = current_user;
#                  If false, run 001, 002, load the data, THEN 003-005.
#
#   POOLER (6543)  the API. Transaction mode, which is safe here only because
#                  withRoles() uses SET LOCAL inside an explicit transaction.
#                  A plain SET would leak the previous user's roles to
#                  whoever gets that connection next.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL_POOLER=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# The API connects as this role, which holds SELECT and nothing else. Never
# the owner: the owner has BYPASSRLS, and connecting as it silently disables
# every policy in the database.
PGUSER=ai_brain_app
PGPASSWORD=
PG_POOL_MAX=10

# Local docker-compose only; on Supabase the two URLs above replace these.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_brain
PG_OWNER_USER=ai_brain_owner
PG_OWNER_PASSWORD=

# --- Identity -------------------------------------------------------------
# Undecided: Supabase ships its own auth, and this assumes Keycloak. Running
# both is redundant - pick one before wiring identity up.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dbc
KEYCLOAK_CLIENT_ID=ai-brain-api
KEYCLOAK_CLIENT_SECRET=

# --- Object storage (MinIO / S3) ------------------------------------------
# Source PDFs. The bytes never enter the database; only a reference.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dbc-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Embeddings and generation --------------------------------------------
# 1536 is what the schema declares. Changing it means re-embedding all 3,842
# passages and rebuilding the index - decide before the first run.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
