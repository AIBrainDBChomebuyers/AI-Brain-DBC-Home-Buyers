infra/data/

# --- the database seed ---------------------------------------------------
# Deliberately NOT committed. It is generated by the extraction pipeline, and
# it carries third-party personal information: the names of people who sold
# houses to DBC, their property addresses, title file numbers, and 3,728
# passages of raw settlement and loan text. Git history is permanent, so once
# that is in it is in - through forks, clones and anyone given repo access
# later.
#
# It is also regenerable, which is what makes leaving it out cost nothing:
#
#     npm run db:sync     # pull the current export from the pipeline
#     npm run db:load     # upsert it into the database
#
# The migrations are a different matter and ARE committed: they describe the
# schema, the indexes and the permission policies, and contain no data.
database/postgres/tables/*.json
database/mongodb/collections/*.json
database/MANIFEST.json
database/schema.json
database/**/*.tmp

# Temp file written by the mutation suite over scripts/verify_migration.py.
# It has to live beside the original (the script resolves the project root
# from __file__), so it lands in a tracked directory for a few seconds.
scripts/_mutation_under_test.py
